{
  "name": "web-extpack",
  "private": false,
  "version": "2.0.1",
  "description": "CLI to bundle a WebExtension module using webpack",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/FileLoader.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kisiwu/web-extpack.git"
  },
  "scripts": {
    "test": "node ./bin/web-extpack build --config test/web-extpackfile.js",
    "help": "node ./bin/web-extpack -h"
  },
  "bin": {
    "web-extpack": "bin/web-extpack.js"
  },
  "keywords": [
    "WebExtension",
    "modules",
    "webpack",
    "npm"
  ],
  "author": "demingongo (https://github.com/demingongo)",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "mkdirp": "^3.0.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "babel-loader": "^10.1.1"
  }
}
